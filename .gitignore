# Godot 4+ specific ignores
.godot/

# Imported translations (automatically generated from CSV files)
*.translation

# Ignoring export folder
/export/

# Compiled Object files

*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build folder
/build/

# IDE specific files
.vscode/
.idea/

# Dependency directories
/bin/
/lib/

# ThirdParty specific ignores
/src/ThirdParty/*
/src/ThirdParty/**/*.build/
/src/ThirdParty/**/*.build.log
/src/ThirdParty/**/test_data/
/src/ThirdParty/**/tests/data/
/src/ThirdParty/**/*.test.*
src/ThirdParty/external/RTNeural/**
src/ThirdParty/external/xsimd/**

# Keep existing ThirdParty rule
*/ThirdParty/*s

# RTNeural test data and generated files
src/ThirdParty/external/RTNeural/test_data/
src/ThirdParty/external/RTNeural/tests/
src/ThirdParty/external/RTNeural/build/
src/ThirdParty/external/RTNeural/.pytest_cache/
src/ThirdParty/external/RTNeural/__pycache__/

# Environment variables
.env
env.local